FROM node:20-slim AS base

# Set pnpm environment variables
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

# Enable corepack for pnpm
RUN corepack enable

WORKDIR /app

# Dependencies stage
FROM base AS deps
# Copy only package files needed for installation
ARG TARGET_APP
COPY pnpm-workspace.yaml ./
COPY apps/${TARGET_APP}/package.json ./apps/${TARGET_APP}/
# Create minimal root package.json 
RUN echo '{"private": true, "workspaces": ["apps/*"], "devDependencies": {}}' > package.json
# Install dependencies
WORKDIR /app
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --prefer-offline

# Build app stage
FROM deps AS builder
ENV NODE_ENV=production
# Copy source code
ARG TARGET_APP
COPY apps/${TARGET_APP} ./apps/${TARGET_APP}
# Build the target app
WORKDIR /app
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm --filter ${TARGET_APP} run build

# Production stage
FROM node:20-slim AS runner
WORKDIR /app

ARG TARGET_APP
# Copy standalone output and package files
COPY --from=builder /app/apps/${TARGET_APP}/.next/standalone/ ./
COPY --from=builder /app/apps/${TARGET_APP}/.next/static/ ./apps/${TARGET_APP}/.next/static/
COPY --from=builder /app/apps/${TARGET_APP}/public/ ./apps/${TARGET_APP}/public/
COPY --from=builder /app/apps/${TARGET_APP}/package.json ./apps/${TARGET_APP}/package.json

# Install nginx and clean up in the same layer
RUN apt-get update && \
    apt-get install -y --no-install-recommends nginx && \
    rm -rf /var/lib/apt/lists/* && \
    rm -rf /usr/share/doc && \
    rm -rf /usr/share/man && \
    rm -rf /usr/share/locale && \
    mkdir -p /run/nginx
COPY apps/storefront/nginx/dev.conf /etc/nginx/conf.d/default.conf

ARG PORT
ENV PORT=${PORT}
ENV NODE_ENV=production
# Create start script with better logging
RUN echo "#!/bin/bash\nset -e\nnginx\necho 'Starting Next.js app...'\ncd /app/apps/${TARGET_APP}\nNODE_ENV=production node server.js" > /start.sh && \
    chmod +x /start.sh

# Use the start script instead of direct command
CMD ["/start.sh"]